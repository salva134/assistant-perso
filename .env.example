# Copier ce fichier en .env puis remplir les valeurs. Le .env n'est jamais committé.

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=

# --- Claude (API) ---
ANTHROPIC_API_KEY=

# --- OpenAI : embeddings + transcription ---
OPENAI_API_KEY=

# --- Supabase : Connect > Session pooler (avec le mot de passe de la base) ---
DATABASE_URL=

# --- Vapi + numéro Twilio (test téléphonie, phase 5) ---
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Ligne OVHcloud (plan B, si elle est activée un jour)
OVH_SIP_USERNAME=
OVH_SIP_PASSWORD=
OVH_SIP_PROXY=
OVH_PHONE_NUMBER=

# --- Google Agenda (phase 4) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

TIMEZONE=Europe/Paris
# Plafond de dépense par jour, en dollars (1 par défaut)
DAILY_BUDGET_USD=1
