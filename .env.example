# Copier ce fichier en .env puis remplir les valeurs. Le .env n'est jamais committé.

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=

# --- Claude (API) ---
ANTHROPIC_API_KEY=

# --- OpenAI : embeddings et transcription des vocaux ---
OPENAI_API_KEY=

# --- Supabase : Connect > Session pooler (avec le mot de passe de la base) ---
DATABASE_URL=
SUPABASE_DB_PASSWORD=

# --- Appels : Vapi + numéro Twilio ---
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Google Agenda (scripts/google_auth.py remplit le refresh token) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# --- Réglages ---
TIMEZONE=Europe/Paris
# Ville d'Hugo, pour orienter la recherche web
HOME_CITY=Aubagne
# Plafond de dépense par jour, en dollars
DAILY_BUDGET_USD=1
